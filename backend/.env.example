# Copia questo file in ".env" e compila i valori.

# URL del sito Jira Cloud INPECO, es: https://inpeco.atlassian.net
JIRA_BASE_URL=https://inpeco.atlassian.net

# Email dell'account Jira usato per generare l'API token
JIRA_EMAIL=nome.cognome@inpeco.com

# API token generato su https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Percorso del database SQLite (relativo alla cartella backend/)
DATABASE_URL=sqlite:///./data/app.db
